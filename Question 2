FRUITS_FILE = "fruits.txt"

FAVOURITE_FRUITS = [
    "Mango",
    "Banana",
    "Pineapple",
    "Strawberry",
    "Watermelon",
]


def write_fruits_to_file(fruits: list[str], filename: str = FRUITS_FILE) -> None:
    with open(filename, "w", encoding="utf-8") as file:
        for fruit in fruits:
            file.write(f"{fruit}\n")


def read_fruits_from_file(filename: str = FRUITS_FILE) -> list[str]:
    with open(filename, "r", encoding="utf-8") as file:
        return [line.strip() for line in file if line.strip()]


def main() -> None:
    write_fruits_to_file(FAVOURITE_FRUITS)
    print(f"Written {len(FAVOURITE_FRUITS)} fruits to '{FRUITS_FILE}'.\n")

    fruits = read_fruits_from_file()
    print("Contents of fruits.txt:")
    for fruit in fruits:
        print(fruit)


if __name__ == "__main__":
    main()
